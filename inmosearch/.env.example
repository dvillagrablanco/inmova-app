# ---------------------------------------------------------------------------
# INMOSEARCH — variables de entorno (copia este fichero a .env y rellena)
# ---------------------------------------------------------------------------

# Base de datos.
# Desarrollo (por defecto): SQLite local, no requiere servidor.
DATABASE_URL="file:./dev.db"
# Producción (recomendado): Postgres. Cambia el provider en prisma/schema.prisma
# a "postgresql" y usa una URL tipo:
# DATABASE_URL="postgresql://user:pass@host:5432/inmosearch?schema=public"

# ---------------------------------------------------------------------------
# IA — Análisis de CapEx a partir de imágenes (Claude Vision).
# Sin esta clave, el estimador de CapEx usa el modelo determinista basado en
# reglas (funciona igual, pero no "mira" las fotos).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Modelo de visión a usar (por defecto un modelo Claude reciente con visión).
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ---------------------------------------------------------------------------
# Conectores de fuentes de oportunidades (opcionales).
# El scraping directo de portales (Idealista, Fotocasa...) viola sus términos
# de uso. INMOSEARCH usa APIs oficiales / import cuando existen.
# ---------------------------------------------------------------------------
# Idealista API oficial (https://developers.idealista.com/) — OAuth2.
IDEALISTA_API_KEY=""
IDEALISTA_API_SECRET=""

# ---------------------------------------------------------------------------
# Parámetros por defecto del inversor (puedes sobrescribirlos por oportunidad).
# ---------------------------------------------------------------------------
# Rentabilidad neta mínima aceptable para alquiler (%).
DEFAULT_MIN_NET_YIELD="6"
# Margen mínimo aceptable para flip (%).
DEFAULT_MIN_FLIP_MARGIN="15"
