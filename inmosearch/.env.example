# ---------------------------------------------------------------------------
# INMOSEARCH — variables de entorno (copia este fichero a .env y rellena)
# ---------------------------------------------------------------------------

# Base de datos.
# Desarrollo (por defecto): SQLite local, no requiere servidor.
DATABASE_URL="file:./dev.db"
# Producción (recomendado): Postgres. Cambia el provider en prisma/schema.prisma
# a "postgresql" y usa una URL tipo:
# DATABASE_URL="postgresql://user:pass@host:5432/inmosearch?schema=public"

# ---------------------------------------------------------------------------
# IA — Análisis de CapEx a partir de imágenes (Claude Vision).
# Sin esta clave, el estimador de CapEx usa el modelo determinista basado en
# reglas (funciona igual, pero no "mira" las fotos).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Modelo de visión a usar (por defecto un modelo Claude reciente con visión).
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ---------------------------------------------------------------------------
# Conectores de fuentes de oportunidades (opcionales).
# El scraping directo de portales (Idealista, Fotocasa...) viola sus términos
# de uso. INMOSEARCH usa APIs oficiales / import cuando existen.
# ---------------------------------------------------------------------------
# Idealista API oficial de BÚSQUEDA (https://developers.idealista.com/) — OAuth2.
# Solicita acceso en developers.idealista.com/access-request (aprobación manual).
# Cuota baja en el nivel de desarrollador (~100 req/mes, ~1 req/s; 50 result./pág).
# La búsqueda es por COORDENADAS o locationId (no por texto libre): en el perfil,
# indica la zona como "lat,lng" o "lat,lng r=8000" (radio en metros).
IDEALISTA_API_KEY=""
IDEALISTA_API_SECRET=""
IDEALISTA_COUNTRY="es"   # índice del país: es | it | pt

# idealista/data — API de comparables y métricas (producto B2B de datos de
# mercado, distinto de la API de búsqueda). Mejora las VALORACIONES con €/m²
# reales de la zona (venta y alquiler), días en mercado, margen de negociación…
# Requiere CONTRATO comercial con idealista/data (tasadoras, consultoras, bancos,
# fondos). Cuando tengas endpoint + clave, configúralo aquí (adaptador genérico:
# sirve para idealista/data o cualquier feed de mercado autorizado con API):
MARKET_DATA_API_URL=""     # p.ej. https://.../valoracion?zona={location}
MARKET_DATA_API_KEY=""     # clave/token del proveedor
MARKET_DATA_PROVIDER="Idealista Data"
MARKET_DATA_AUTH_HEADER=""  # opcional: cabecera alternativa (p.ej. X-Api-Key). Vacío = Bearer
MARKET_DATA_SALE_FIELD=""   # opcional: ruta al €/m² de venta en la respuesta (p.ej. data.saleEurSqm)
MARKET_DATA_RENT_FIELD=""   # opcional: ruta al €/m²/mes de alquiler (p.ej. data.rentEurSqm)

# Conexión a Idealista/Fotocasa vía tus ALERTAS por email leídas de un buzón
# IMAP (lectura de tu propio correo). Crea alertas/búsquedas guardadas en los
# portales que envíen a este buzón; el endpoint /api/ingest/email/poll (cron)
# las importa. Para Gmail usa una "contraseña de aplicación".
IMAP_HOST=""          # p.ej. imap.gmail.com
IMAP_PORT="993"
IMAP_USER=""          # tu email
IMAP_PASSWORD=""      # contraseña de aplicación (no la normal)
IMAP_MAILBOX="INBOX"  # carpeta donde llegan las alertas
IMAP_TLS="true"
IMAP_MARK_SEEN="true" # marcar como leídos los emails procesados

# Subastas BOE (subastas.boe.es) — fuente pública. Activo por defecto.
# Ponlo a "false" para desactivarlo. (BETA: verifica el formato en producción.)
BOE_ENABLED="true"

# Adaptador de fuente autorizada (feed JSON). Úsalo SOLO con fuentes que estés
# autorizado a consumir (partner REO, tu propia API...). No lo apuntes a
# portales cuyos Términos prohíban el acceso automatizado.
HTTP_SOURCE_FEED_URL=""
HTTP_SOURCE_AUTH=""   # p.ej. "Bearer xxxxx" si el feed lo requiere
HTTP_SOURCE_UA=""     # User-Agent personalizado (opcional)

# Catastro (Sede Electrónica) — enriquecimiento de valoración (m² reales, año).
# Ponlo a "true" para activarlo. (BETA: el emparejamiento por dirección es
# sensible al formato.)
CATASTRO_ENABLED="false"

# ---------------------------------------------------------------------------
# Barridos automáticos (cron). El endpoint /api/sweep/run ejecuta los barridos
# que tocan según la programación de cada perfil. Protégelo con un secreto.
# ---------------------------------------------------------------------------
SWEEP_SECRET=""       # secreto para autorizar /api/sweep/run (o usa CRON_SECRET en Vercel)

# ---------------------------------------------------------------------------
# Alertas de nuevas oportunidades que encajan (tras cada barrido). Opcional.
# Configura al menos un canal; si no, no se envía nada.
# ---------------------------------------------------------------------------
APP_BASE_URL=""            # p.ej. https://inmosearch.tudominio.com (para enlaces en las alertas)
# Canal 1 — Webhook (Slack, Make, Zapier, n8n, o tu endpoint de email):
ALERTS_WEBHOOK_URL=""
# Canal 2 — Email vía Resend (API HTTP, sin SMTP): https://resend.com
ALERTS_RESEND_API_KEY=""
ALERTS_EMAIL_FROM=""       # p.ej. "INMOSEARCH <alertas@tudominio.com>"
ALERTS_EMAIL_TO=""         # uno o varios, separados por coma

# ---------------------------------------------------------------------------
# Parámetros por defecto del inversor (puedes sobrescribirlos por oportunidad).
# ---------------------------------------------------------------------------
# Rentabilidad neta mínima aceptable para alquiler (%).
DEFAULT_MIN_NET_YIELD="6"
# Margen mínimo aceptable para flip (%).
DEFAULT_MIN_FLIP_MARGIN="15"
