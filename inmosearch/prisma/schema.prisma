// INMOSEARCH — esquema de datos
// -----------------------------------------------------------------------------
// Provider por defecto: SQLite (cero configuración para desarrollo).
// Para producción, cambia `provider` a "postgresql" y ajusta DATABASE_URL.
// Los campos que guardan estructuras (imágenes, desglose de CapEx, análisis)
// se almacenan como String con JSON serializado para ser 100% portables entre
// SQLite y Postgres. El parseo/validación se hace en la capa de aplicación.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Opportunity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Origen ---------------------------------------------------------------
  source    String  @default("MANUAL") // MANUAL | IDEALISTA | REO_BANK | AUCTION | CSV | MOCK | BOE | HTTP
  sourceUrl String?
  sourceRef String? // id/referencia en la fuente original
  dedupKey  String? @unique // clave de deduplicación (evita duplicados en barridos)

  // --- Captación (barridos) -------------------------------------------------
  profileId  String?
  profile    SearchProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  matched    Boolean @default(false) // ¿cumple el perfil de activos (buy-box)?
  matchScore Int? // 0-100 de encaje con el perfil
  enriched   Boolean @default(false) // ¿enriquecida con Catastro u otras fuentes?

  // --- Localización ---------------------------------------------------------
  title      String
  address    String?
  city       String?
  province   String?
  ccaa       String? // Comunidad Autónoma (para calcular ITP)
  postalCode String?
  lat        Float?
  lng        Float?

  // --- Características del activo -------------------------------------------
  propertyType String  @default("PISO") // PISO | CASA | ATICO | DUPLEX | ESTUDIO | LOCAL | OTRO
  askingPrice  Int // precio de oferta (€)
  builtArea    Float? // m² construidos
  usableArea   Float? // m² útiles
  rooms        Int?
  baths        Int?
  floor        String?
  hasElevator  Boolean @default(false)
  yearBuilt    Int?
  condition    String? // A_REFORMAR | REFORMA_PARCIAL | BUEN_ESTADO | REFORMADO | OBRA_NUEVA
  description  String?
  images       String  @default("[]") // JSON: string[] de URLs

  // --- Supuestos de mercado (comparables). Rellenables/estimables ----------
  arvPricePerSqm    Float? // valor de venta objetivo tras reforma (€/m²)
  marketRentMonthly Float? // renta de mercado estimada (€/mes)

  // --- CapEx (reforma) ------------------------------------------------------
  capexLevel     String? // LAVADO_CARA | REFORMA_MEDIA | REFORMA_INTEGRAL
  capexEstimate  Int? // coste total estimado de reforma (€)
  capexPerSqm    Float?
  capexBreakdown String  @default("[]") // JSON: partidas de reforma
  capexSource    String  @default("NONE") // NONE | RULE_BASED | AI_VISION | MANUAL

  // --- Resultado del análisis ----------------------------------------------
  analysis   String? // JSON: resultado completo del underwriting
  score      Int? // 0-100
  rating     String? // A | B | C | D
  verdict    String? // INVERTIR | VIGILAR | DESCARTAR
  bestStrategy String? // FLIP | RENT | BOTH | NONE

  // --- Gestión --------------------------------------------------------------
  status String  @default("NEW") // NEW | SHORTLISTED | PURSUING | DISCARDED | CLOSED
  notes  String?

  @@index([status])
  @@index([score])
  @@index([ccaa])
  @@index([verdict])
  @@index([profileId])
  @@index([matched])
}

// -----------------------------------------------------------------------------
// Perfil de activos (buy-box) + zonas + fuentes. Define QUÉ busca el usuario y
// DÓNDE, y los umbrales para considerar una oportunidad "match".
// -----------------------------------------------------------------------------
model SearchProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name   String
  active Boolean @default(true)

  // Zonas de interés (JSON string[]): provincias, municipios o códigos postales.
  zones String @default("[]")
  // Fuentes a barrer (JSON string[]): ["boe","idealista","reo-banks","http","mock"].
  sources String @default("[]")

  // --- Buy-box (criterios del activo) ---
  propertyTypes       String  @default("[]") // JSON string[]
  minPrice            Int?
  maxPrice            Int?
  minArea             Float?
  maxPricePerSqm      Float?
  minRooms            Int?
  conditions          String  @default("[]") // JSON string[]
  minNetYield         Float? // % rentabilidad neta mínima (alquiler)
  minFlipMargin       Float? // % margen mínimo (flip)
  minDiscountToMarket Float? // % descuento mínimo frente a mercado
  keywords            String? // palabras clave (coma-separadas)

  // --- Programación ---
  schedule  String  @default("weekly") // weekly | daily | 6h | manual
  lastRunAt DateTime?

  opportunities Opportunity[]
  runs          SweepRun[]

  @@index([active])
}

// -----------------------------------------------------------------------------
// Registro de cada ejecución de barrido (para trazabilidad y alertas).
// -----------------------------------------------------------------------------
model SweepRun {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  profileId String?
  profile   SearchProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  status     String @default("OK") // OK | PARTIAL | ERROR
  found      Int    @default(0) // anuncios encontrados
  imported   Int    @default(0) // nuevos importados
  matched    Int    @default(0) // que cumplen el buy-box
  duplicates Int    @default(0) // descartados por duplicado
  bySource   String @default("[]") // JSON: [{source, found, error}]
  notes      String?

  @@index([profileId])
  @@index([createdAt])
}
